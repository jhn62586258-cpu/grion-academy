rules_version = '2';

// 그리온 말씀 사관학교 - Firestore 보안 규칙
// ※ 로그인 없이(닉네임+PIN) 쓰는 소규모 교회용 구성입니다.
//   PIN 해시는 별도 컬렉션(pins)에 두고 '목록 조회'를 막아, 닉네임을 모르면 접근할 수 없게 했습니다.
//   더 강한 보안이 필요하면 README의 '보안 강화' 항목(Anonymous Auth + Cloud Functions)을 참고하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    // 교사 프로필/진도/포인트 (랭킹 보드에서 모두 읽을 수 있음. PIN 정보는 여기에 없음)
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['classId', 'nickname', 'progress', 'clearedCount', 'biscuits', 'xp',
           'items', 'titles', 'title', 'createdAt', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 10
        && request.resource.data.classId is string
        && request.resource.data.classId.size() <= 20
        && request.resource.data.biscuits <= 100;
      // 소속 반/닉네임은 변경 불가
      allow update: if request.resource.data.classId == resource.data.classId
        && request.resource.data.nickname == resource.data.nickname;
      allow delete: if false;
    }

    // PIN 해시: 문서 ID(반+닉네임)를 알아야만 get 가능. list/수정/삭제 불가.
    match /pins/{userId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['pinHash', 'createdAt'])
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash.size() == 64;
      allow update, delete: if false;
    }

    // 마음의 편지 (익명 고충 게시판)
    match /letters/{letterId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['text', 'createdAt', 'hearts', 'heartedBy', 'commentCount'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 500
        && request.resource.data.hearts == 0
        && request.resource.data.commentCount == 0;
      // 공감(하트)/댓글 수만 수정 가능
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['hearts', 'heartedBy', 'commentCount']);
      allow delete: if false; // 부적절한 글은 Firebase 콘솔에서 관리자가 삭제

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }
    }
  }
}
